# LLM Provider API Keys (依使用需求設定其中一個或多個)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 預設路由器模型 (建議使用速度快且便宜的模型，例如 gpt-4o-mini 或 gemini-1.5-flash)
ROUTER_MODEL=gemini/gemini-1.5-flash
# 預設執行專家模型 (需要深入推理時使用，例如 gpt-4o 或 claude-3-5-sonnet)
EXPERT_MODEL=gemini/gemini-1.5-pro

# 模式開關設定 (預設全部啟用)
ENABLE_VERIFIER_GATED=true
ENABLE_MULTI_AGENT=true
ENABLE_REFLECTION=true
